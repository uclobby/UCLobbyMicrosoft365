<?xml version="1.0" encoding="utf-8"?>
<Configuration>
	<ViewDefinitions>
		<View>
			<Name>M365TenantId</Name>
			<ViewSelectedBy>
				<TypeName>M365TenantId</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>Tenant ID</Label>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>OnMicrosoft Domain</Label>
					</TableColumnHeader>					
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>TenantID</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>OnMicrosoftDomain</PropertyName>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
	</ViewDefinitions>
</Configuration>